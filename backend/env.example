# ── Copy this to .env and fill in your values ──────────────────────────────
# On Railway, set these as environment variables (not this file)

NODE_ENV=development
PORT=5000

# PostgreSQL — Railway provides this automatically as DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/kenyawatch

# Anthropic API Key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Frontend URL for CORS — set to your Railway frontend URL in production
FRONTEND_URL=http://localhost:3000
